# Copie este arquivo com o nome  .env.local  e preencha os valores.
# NUNCA publique este arquivo preenchido (nem no GitHub, nem em zip de venda).

# — Supabase (painel do projeto → Project Settings → API) —
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role-secreta

# — Alarme (push). Gere as duas chaves com:  npx web-push generate-vapid-keys —
VAPID_PUBLIC_KEY=cole-aqui-a-chave-publica
VAPID_PRIVATE_KEY=cole-aqui-a-chave-privada
VAPID_CONTATO=seu-email@exemplo.com
